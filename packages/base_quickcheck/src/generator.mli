[@@@ocaml.text
  " {2 Low-Level Interface}\n\n\
  \    These functions provide direct access to the pseudo-random state threaded through\n\
  \    Base_quickcheck generators. Most users should not need these functions.\n"]

val perturb : 'a t -> int -> 'a t
[@@ocaml.doc
  " Passes in additional \"salt\" used to perturb the pseudo-random state used to generate\n\
  \    random values. Generators' output is intended to be deterministic for any initial\n\
  \    pseudorandom state, so [perturb] can be used to generate a new generator with the \
   same\n\
  \    distribution that nonetheless produces different values from the original for any\n\
  \    given pseudo-random state. "]

val create : (size:int -> random:Splittable_random.t -> 'a) -> 'a t
[@@ocaml.doc
  " Creates a generator that calls the given function with the current size parameter and\n\
  \    pseudorandom state. "]

val generate : 'a t -> size:int -> random:Splittable_random.t -> 'a
[@@ocaml.doc
  " Generates a random value using the given size and pseudorandom state. Useful when\n\
  \    using [create] and dispatching to other existing generators. "]

module Debug : sig
  [@@@ocaml.text " {3 Helpers for debugging generators} "]

  val coverage
    :  (module Comparator.S with type t = 'k and type comparator_witness = 'cmp)
    -> 'k Sequence.t
    -> ('k, int, 'cmp) Map.t
  [@@ocaml.doc
    " [coverage (module Key) sample] counts how many times each key appears in [sample].\n\n\
    \      See [Test.with_sample] for a convenient way to generate [sample]. "]

  val monitor : 'a t -> f:('a -> unit) -> 'a t
  [@@ocaml.doc
    " [monitor t ~f] returns a generator which gives the same values as [t] and also calls\n\
    \      [f] for each value. This can help diagnose behavior of generators \"hidden\" \
     behind\n\
    \      [map], [filter], etc. One might count the number of values a generator \
     produces, or\n\
    \      record the set of values that do not satisfy some filter. "]
end
